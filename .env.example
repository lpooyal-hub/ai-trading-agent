POSTGRES_PASSWORD=ai_trading_agent_dev_password
DATABASE_URL=postgresql+psycopg://ai_trading_agent:ai_trading_agent_dev_password@postgres:5432/ai_trading_agent

VITE_API_BASE_URL=
VITE_ALLOWED_HOSTS=
VITE_PROXY_API_TARGET=http://backend:8000
