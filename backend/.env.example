BROKER_PROVIDER=toss_securities
# Docker Compose uses this same backend/.env file for backend, frontend, and postgres.
POSTGRES_DB=ai_trading_agent
POSTGRES_USER=ai_trading_agent
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql+psycopg://ai_trading_agent:change_this_postgres_password@postgres:5432/ai_trading_agent
# Local backend-only fallback:
# DATABASE_URL=sqlite:///./data/trading_agent.db
VITE_API_BASE_URL=
VITE_ALLOWED_HOSTS=
VITE_PROXY_API_TARGET=http://backend:8000
# Only needed when serving through a TLS reverse proxy (see vite.config.ts) --
# leave unset for direct local access on localhost.
VITE_HMR_HOST=
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443
# Keep DRY_RUN=true for public/demo usage.
DRY_RUN=true
LIVE_TRADING_ENABLED=false
USE_MOCK_DATA=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
REQUIRE_ADMIN_API_KEY=false
ADMIN_API_KEY=
# Trading-money amounts are KRW (domestic KRX market). LLM cost limits below
# stay in USD on purpose -- OpenAI bills in USD regardless of trading market.
BOT_CAPITAL_LIMIT_KRW=300000
# Zero disables the per-order cap while portfolio-level guardrails remain on.
MAX_ORDER_AMOUNT_KRW=130000
MAX_POSITIONS=3
MAX_DAILY_TRADES=5
MAX_SYMBOL_EXPOSURE_PERCENT=40
MIN_CASH_RESERVE_KRW=30000
FRACTIONAL_TRADING_ENABLED=false
MIN_ORDER_AMOUNT_KRW=5000
QUANTITY_DECIMAL_PLACES=0
ORDER_SIZING_MODE=notional
# No single-sector restriction -- the agent picks freely across sectors
# within this whitelist (the actual safety boundary, enforced by RiskManager).
ALLOWED_SYMBOLS=005930,000660,005380,000270,373220,207940,035420,035720,005490,068270
FORBIDDEN_KEYWORDS=leveraged,inverse,2x,3x,bull,bear,short
PROTECTED_SYMBOLS=
DEFAULT_STOP_MODE=agent_with_hard_guardrails
HARD_MAX_POSITION_LOSS_PERCENT=25
HARD_DAILY_LOSS_LIMIT_PERCENT=10
# Paper-only deterministic exits. Zero disables an individual threshold.
POSITION_EXIT_ENABLED=true
POSITION_STOP_LOSS_PERCENT=5
POSITION_TAKE_PROFIT_PERCENT=8
POSITION_TRAILING_STOP_ENABLED=true
POSITION_TRAILING_ACTIVATION_PERCENT=4
POSITION_TRAILING_DISTANCE_PERCENT=2.5
POSITION_MAX_HOLDING_TRADING_DAYS=10
POSITION_EXIT_MAX_SNAPSHOT_AGE_SECONDS=120
LLM_DAILY_COST_LIMIT_USD=2
LLM_MONTHLY_COST_LIMIT_USD=30
LLM_DAILY_TOKEN_LIMIT=100000
LLM_DAILY_CALL_LIMIT=5
LLM_MIN_MINUTES_BETWEEN_CALLS=60
LLM_MAX_CANDIDATES_PER_RUN=3
LLM_MODEL_DECISION=
LLM_MODEL_EVALUATION=
LLM_MODEL_REFLECTION=
LLM_REASONING_EFFORT_DECISION=low
LLM_INPUT_COST_PER_1M_TOKENS_USD=0
LLM_OUTPUT_COST_PER_1M_TOKENS_USD=0
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_SECONDS=30
MARKET_SNAPSHOT_MAX_AGE_MINUTES=30
INTRADAY_SIGNALS_ENABLED=false
INTRADAY_SHORTLIST_SIZE=6
INTRADAY_CANDLE_COUNT=30
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_AGENT_RUN_LOCK_TTL_SECONDS=300
AGENT_AUTOMATION_ENABLED=false
AGENT_AUTOMATION_MODE=manual_approval
AGENT_AUTO_EXECUTE_MIN_CONFIDENCE=0.75
# Zero disables the paper-auto per-order cap.
AGENT_AUTO_EXECUTE_MAX_ORDER_AMOUNT_KRW=65000
AGENT_SCHEDULER_ENABLED=false
AGENT_SCHEDULER_INTERVAL_MINUTES=60
AGENT_SCHEDULER_MARKET_HOURS_ONLY=true
# Domestic KRX regular session (KOSPI/KOSDAQ).
AGENT_MARKET_TIMEZONE=Asia/Seoul
AGENT_MARKET_OPEN_TIME=09:00
AGENT_MARKET_CLOSE_TIME=15:30
AGENT_MARKET_CLOSED_DATES=
# Continuous session loop: how many decision cycles and how many minutes a
# single session may run before it must stop on its own (agent_session_max_minutes
# and market-close still apply as independent stop guards regardless of this
# count). At AGENT_SCHEDULER_INTERVAL_MINUTES=5, a full KRX session (390
# minutes) needs ~78 cycles -- keep this comfortably above that so cycle count
# never becomes the reason the session ends early.
AGENT_SESSION_MAX_CYCLES=90
AGENT_SESSION_MAX_MINUTES=420

TOSS_API_KEY=
TOSS_SECRET_KEY=
TOSS_ACCOUNT_ID=
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_TOKEN_PATH=/oauth2/token
TOSS_ACCOUNT_LIST_PATH=/api/v1/accounts
TOSS_HOLDINGS_PATH=/api/v1/holdings
TOSS_CANDLES_PATH=/api/v1/candles
TOSS_PRICES_PATH=/api/v1/prices
TOSS_ORDERBOOK_PATH=/api/v1/orderbook
TOSS_ORDER_PATH=
TOSS_ORDER_STATUS_PATH=
TOSS_ORDER_CANCEL_PATH=
TOSS_ORDER_ACCOUNT_HEADER_NAME=X-Tossinvest-Account
TOSS_ORDER_IDEMPOTENCY_HEADER_NAME=Idempotency-Key
TOSS_TIMEOUT_SECONDS=8
TOSS_READ_CACHE_TTL_SECONDS=15
OPENAI_API_KEY=
