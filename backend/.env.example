BROKER_PROVIDER=toss_securities
# Keep DRY_RUN=true for this public research build.
# LIVE_TRADING_ENABLED=true alone does not send real orders; live order execution is still intentionally blocked.
DRY_RUN=true
LIVE_TRADING_ENABLED=false
USE_MOCK_DATA=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BOT_CAPITAL_LIMIT_USD=250
MAX_ORDER_AMOUNT_USD=100
MAX_POSITIONS=3
MAX_DAILY_TRADES=5
MIN_CASH_RESERVE_USD=25
ALLOWED_SECTOR=semiconductor
ALLOWED_SYMBOLS=NVDA,AMD,TSM,AVGO,ASML,QCOM,MU,ARM,INTC,AMAT
FORBIDDEN_KEYWORDS=leveraged,inverse,2x,3x,bull,bear,short
PROTECTED_SYMBOLS=
DEFAULT_STOP_MODE=agent_with_hard_guardrails
HARD_MAX_POSITION_LOSS_PERCENT=25
HARD_DAILY_LOSS_LIMIT_PERCENT=10
LLM_DAILY_COST_LIMIT_USD=2
LLM_MONTHLY_COST_LIMIT_USD=30
LLM_DAILY_TOKEN_LIMIT=100000
LLM_DAILY_CALL_LIMIT=5
LLM_MIN_MINUTES_BETWEEN_CALLS=60
LLM_MAX_CANDIDATES_PER_RUN=3
LLM_MODEL_DECISION=
LLM_MODEL_EVALUATION=
LLM_MODEL_REFLECTION=
LLM_INPUT_COST_PER_1M_TOKENS_USD=0
LLM_OUTPUT_COST_PER_1M_TOKENS_USD=0
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_SECONDS=30
MARKET_SNAPSHOT_MAX_AGE_MINUTES=30
REDIS_ENABLED=false
REDIS_URL=redis://host.docker.internal:6379/0
REDIS_AGENT_RUN_LOCK_TTL_SECONDS=300
AGENT_AUTOMATION_ENABLED=false
AGENT_AUTOMATION_MODE=manual_approval
AGENT_AUTO_EXECUTE_MIN_CONFIDENCE=0.75
AGENT_AUTO_EXECUTE_MAX_ORDER_AMOUNT_USD=50
AGENT_SCHEDULER_ENABLED=false
AGENT_SCHEDULER_INTERVAL_MINUTES=60
AGENT_SCHEDULER_MARKET_HOURS_ONLY=true
AGENT_MARKET_TIMEZONE=America/New_York
AGENT_MARKET_OPEN_TIME=09:30
AGENT_MARKET_CLOSE_TIME=16:00
AGENT_MARKET_CLOSED_DATES=

TOSS_API_KEY=
TOSS_SECRET_KEY=
TOSS_ACCOUNT_ID=
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_TOKEN_PATH=/oauth2/token
TOSS_ACCOUNT_LIST_PATH=/api/v1/accounts
TOSS_HOLDINGS_PATH=/api/v1/holdings
TOSS_TIMEOUT_SECONDS=8
TOSS_READ_CACHE_TTL_SECONDS=15
OPENAI_API_KEY=
